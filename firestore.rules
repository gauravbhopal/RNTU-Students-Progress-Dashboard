rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'superadmin';
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isAdminOfTenant(tenantId) {
      return isAuthenticated() && getUserData().role == 'admin' && getUserData().tenantId == tenantId;
    }

    // ── Users collection ──
    // Users can read their own document; superadmin can read all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId && request.auth.token.email == 'superadmin@gmail.com');
    }

    // ── Tenants collection ──
    // SuperAdmin: full access; Admin: read only their own tenant doc
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isAdminOfTenant(tenantId));
      allow create, update, delete: if isSuperAdmin();

      // ── Students subcollection ──
      // SuperAdmin: full access; Admin: full access to their own tenant's students
      match /students/{studentId} {
        allow read, write: if isAuthenticated() && (isSuperAdmin() || isAdminOfTenant(tenantId));
      }
    }
  }
}
